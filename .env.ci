# CI's settings for the specs. The CI & CD workflow (.github/workflows/main.yml) copies this file to .env.test before
# the app boots, and dotenv-rails loads it. It's committed because it holds no secret: the login is the one of the
# workflow's postgres service, which exists only while the job runs. RAILS_ENV and CI stay in the workflow, which needs
# them before dotenv loads.
OPENCOURTS_PROKURATURA_DATABASE_HOST=localhost
OPENCOURTS_PROKURATURA_DATABASE_USER=postgres
OPENCOURTS_PROKURATURA_DATABASE_PASSWORD=postgres # betterleaks:allow
