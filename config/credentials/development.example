# A template for your own development credentials; git ignores the real ones. Development needs none of these: each
# turns on one service locally. Make yours with `bin/rails credentials:edit --environment development` and copy in
# what you need. Production's are listed in config/initializers/production_boot_check.rb.
google:
  analytics:
    tracking_id:              # Google Analytics, once the visitor allows analytics cookies
  api:
    search:                   # Google Custom Search, for the news about offices and prosecutors
      key:
      id:
geoapify:
  key:                        # geocodes the offices' addresses on import
sentry:
  dsn:                        # Sentry reports only from production
skylight:
  token:
