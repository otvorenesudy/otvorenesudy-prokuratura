# Settings for the specs (bin/test), which dotenv-rails loads from .env.test, then .env for what this file leaves out.
# bin/setup copies this file to .env.test when there is none; edit .env.test for this machine and never commit it. CI
# uses .env.ci instead. Everything here is optional: without it, the specs log in to PostgreSQL on localhost with the
# login in Rails credentials, or else as your own user.

# PostgreSQL, for the opencourts_prokuratura_test database
OPENCOURTS_PROKURATURA_DATABASE_HOST=localhost
# OPENCOURTS_PROKURATURA_DATABASE_USER=postgres
# OPENCOURTS_PROKURATURA_DATABASE_PASSWORD=
