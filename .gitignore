.bundle
.idea
.DS_Store

/storage
/tags

/log/*
/tmp/*

!/log/.keep
!/tmp/.keep

# Rails credentials' keys (production's encrypted file is committed). Each developer keeps their own development
# credentials, from config/credentials/development.example.
/config/master.key
/config/credentials/*.key
/config/credentials/development.*
!/config/credentials/development.example

# Generated nightly (config/sitemap.rb)
/public/sitemap*.xml.gz

# dotenv: .env (development) and .env.test (specs) hold each machine's settings, such as the database login; bin/setup
# creates them from the committed .env.example and .env.test.example, and CI copies the committed .env.ci to .env.test.
# .env.local and .env.<environment>.local override them. None of these is committed.
/.env
/.env.local
/.env.*.local
/.env.test

# Claude Code: personal settings and agent worktrees
/.claude/settings.local.json
/.claude/worktrees/
/.claude/plans

# Node tooling (Prettier, esbuild), Dart Sass builds and coverage reports
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/coverage/
