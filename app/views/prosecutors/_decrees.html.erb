<div class="table-responsive-md mt-2" data-controller="table-filter">
  <div class="row mt-3 mb-3">
    <div class="col-lg-6 pt-1">
      <h4>
        <%= t('.table_title') %> <small class="text-muted">(<span data-table-filter-target="count"><%= @decrees.size %></span>)</small>
      </h4>

      <% if @paragraphs.present? %>
        <h4>
          <small class="text-muted">
            <%= t '.filtered_by' %> <%= @paragraphs.map(&:name).to_sentence %>

            <%= link_to '×', prosecutor_path(params[:id], tab: 'decrees'), class: 'cancel', 'aria-label': t('offices.decrees.cancel_filter') %>
          </small>
        </h4>
      <% end %>
    </div>
    <div class="col-lg-6">
      <%= render 'shared/table_filter', placeholder: t('.search.placeholder') %>
    </div>
  </div>

  <%= table_tag class: 'table' do %>
    <thead>
      <tr>
        <%= table_header_tag t('.office'), class: 'text-start' %>
        <%= table_header_tag t('.number'), class: 'text-start' %>
        <%= table_header_tag t('.effective_on'), class: 'text-start', 'aria-sort': 'descending' %>
        <%= table_header_tag t('.file_number'), class: 'text-start' %>
        <%= table_header_tag t('.paragraph'), class: 'text-start' %>
        <%= table_header_tag t('.resolution'), class: 'text-start' %>
        <%= table_header_tag t('.means_of_resolution'), class: 'text-start' %>
      </tr>
    </thead>
    <tbody>
      <% @decrees.includes(:office, :paragraph).reorder(effective_on: :desc).each do |decree| %>
        <tr>
          <td data-search-value="<%= decree.office&.name %>"><%= decree.office ? link_to(decree.office.name, office_path(decree.office)) : '–' %></td>
          <td><%= link_to_source decree.number, decree.url %></td>
          <td data-value="<%= decree.effective_on %>"><%= tooltip_tag(l(decree.effective_on), t('.published', date: l(decree.published_on))) %></td>
          <td><%= decree.file_number %></td>
          <td data-search-value="<%= decree.paragraph&.name %>"><%= render 'shared/decree_paragraph', decree: %></td>
          <td data-search-value="<%= decree.resolution %>"><%= decree.resolution %></td>
          <td data-search-value="<%= decree.means_of_resolution %>"><%= decree.means_of_resolution %></td>
        </tr>
      <% end %>

      <tr data-table-filter-target="empty" hidden>
        <td colspan="7" class="text-center"><em><%= t('.search.no_results') %></em></td>
      </tr>
    </tbody>
  <% end %>
</div>
