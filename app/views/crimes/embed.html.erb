<% code = capture do %>
<iframe src="<%= export_crimes_url(@search.params.merge(embedded: true)) %>" width="100%" height="<%= params[:show_default_paragraphs].present? ? 1280 : 800 %>px" frameborder="0" sandbox="allow-same-origin allow-scripts allow-popups">
  <p>
    <a href="https://developer.mozilla.org/en-US/docs/Glossary">Fallback link for browsers that don't support iframes</a>
  </p>
</iframe>
<% end %>

<%= code %>

<div class="mb-3">
  <textarea name="embed" id="embed" rows="10" cols="40" class="w-100 mt-3 form-control" disabled><%= code.to_str.strip %></textarea>
</div>
