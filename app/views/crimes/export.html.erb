<div class="statistics-export">
  <div class="d-flex flex-wrap align-items-center justify-content-between">
  <h1 class="display-2 text-uppercase me-sm-4 mt-1 pe-5">
    <%= t 'crimes.index.title' %>
  </h1>

  <%= brand_tag('transparency-international-slovensko', width: 197.92, height: 47.5, variant: I18n.locale) %>

  <div class="w-100">
    <h1 class="text-uppercase">
      <small class="text-muted">
        <% if @search.default_params? && params[:show_default_paragraphs].blank? %>
          <%= t 'crimes.index.subtitle_for_default_params' %>
        <% else %>
          <%= crimes_subtitle(@search) %>
        <% end %>
      </small>
    </h1>

    <% if @search.data[:data].present? %>
      <%= tag.div class: 'mt-5 chart', data: {
            controller: 'crimes-chart',
            crimes_chart_data_value: @data.to_json,
            crimes_chart_animated_value: false
          } do %>
        <canvas data-crimes-chart-target="canvas" role="img" aria-label="<%= t 'crimes.index.title' %>"></canvas>
      <% end %>

      <small class="mt-2 text-muted float-end text-end">
        <%= t 'statistics.index.data_disclaimer' %>
        <br>
        <% if params[:embedded] %>
          <%= link_to t('.open_in_application'), crimes_url(@search.params), class: 'text-muted', target: :_blank %>
          &middot;&nbsp;
        <% end %>
        <%= t 'statistics.index.data_source_disclaimer_html' %>
      </small>
    <% else %>
      <p class="text-center text-muted mt-5 p-5"><%= t '.no_data' %></p>
    <% end %>
  </div>
</div>
