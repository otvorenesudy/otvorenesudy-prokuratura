<%= render 'decrees_table', loading: false do %>
  <% @decrees.includes(:prosecutor, :paragraph).order(effective_on: :desc).each do |decree| %>
    <tr>
      <td data-search-value="<%= decree.prosecutor&.name %>"><%= decree.prosecutor ? link_to(decree.prosecutor.name, prosecutor_path(decree.prosecutor), target: :_top) : '–' %></td>
      <td><%= link_to_source decree.number, decree.url %></td>
      <td data-value="<%= decree.effective_on %>"><%= tooltip_tag(l(decree.effective_on), t('offices.decrees.published', date: l(decree.published_on))) %></td>
      <td><%= decree.file_number %></td>
      <td data-search-value="<%= decree.paragraph&.name %>"><%= render 'shared/decree_paragraph', decree: %></td>
      <td data-search-value="<%= decree.resolution %>"><%= decree.resolution %></td>
      <td data-search-value="<%= decree.means_of_resolution %>"><%= decree.means_of_resolution %></td>
    </tr>
  <% end %>
<% end %>
