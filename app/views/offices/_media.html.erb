<% @office.articles.tap do |articles| %>
  <ul class="list-unstyled mt-4">
    <% articles.each do |article| %>
      <li class="mb-3">
        <%= link_to_source article['title'], article['url'] %> <span class="text-muted">&middot; <%= article['source'] %></span>
        <br>
        <span class="text-muted"><%= article['snippet'] %></span>
      </li>
    <% end %>
  </ul>

  <% if articles.any? %>
    <p>
      <small class="text-muted">
        <a href="<%= GoogleNews.search_url_for(@office) %>"><%= t 'offices.show.media.more_from_google' %></a>

        &middot;

        <%= t 'offices.show.media.disclaimer' %>
      </small>
    </p>
  <% else %>
    <p class="text-muted">
      <%= t 'offices.show.media.no_results' %>
    </p>
  <% end %>
<% end %>
