<%
  slides = [
    ['slides/vytrvame-darujte-pastircak.png', 'V snahe o lepšie Slovensko vytrváme', 'https://transparency.darujme.sk/vytrvame/?referral_tag_id=c13469f4-d80f-4275-96d8-d3839823a3a3'],
    ['slides/2-percenta-2023.png', '2% pre Transparency International', 'https://transparency.sk/sk/2percenta'],
    ['slides/prokuratura-navod.svg', 'Návod na portál Otvorená Prokuratúra', 'https://www.youtube.com/watch?v=AbPwNs768h4'],
    ['slides/rytieri.png', 'Rytieri a bojovníčky Transparency', 'https://transparency.sk/sk/rytieri'],
    ['slides/justicia-a-infozakon.svg', 'Justícia a infozákon', 'https://transparency.sk/sk/akademia/temy/justicia'],
    ['slides/rodinne-vazby-sudcov.svg', 'Rodinné väzby sudcov', 'http://sudy.transparency.sk'],
    ['slides/korupcia-zabija-spravodlivost.svg', 'Korupcia zabíja spravodlivosť', 'https://transparency.darujme.sk/2319/?donation=40&periodicity=periodical'],
    ['slides/spravy-z-boja-proti-korupcii.svg', 'Správy z boja proti korupcii', 'https://eepurl.com/doWD8X']
  ]
%>

<div class="row">
  <div class="col">
    <div id="carousel" class="carousel carousel-fade slide mb-5" data-bs-ride="carousel">
      <div class="carousel-inner mb-3 text-center">
        <% slides.each_with_index do |(image, text, url), index| %>
          <div class="carousel-item<%= ' active' if index.zero? %>">
            <%= link_to image_tag(image, alt: text, class: 'd-block w-100'), url, class: 'd-block w-100' %>
          </div>
        <% end %>
      </div>
      <div class="carousel-indicators">
        <% slides.each_with_index do |(_, text, _), index| %>
          <%= button_tag '', type: 'button', class: ('active' if index.zero?), data: { bs_target: '#carousel', bs_slide_to: index }, 'aria-current': (true if index.zero?), 'aria-label': text %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row">
   <div class="col-12 col-lg-7 col-xl-6 d-flex flex-column pb-lg-4">
     <div class="feature flex-grow-1 p-4">
       <h1 class="text-info mb-4">
         <%= t('.feature.headline') %>
         <br>
         <%= t('.feature.footline') %>
       </h1>
       <h4 class="mb-3">
         <%= t('.feature.list_html', project: tag.span(t('.feature.project'), class: 'text-uppercase')) %>
       </h4>
       <div class="d-flex align-items-center">
         <ol class="list-unstyled mb-0">
           <% t('.feature.items').each do |item| %>
             <li><%= item %></li>
           <% end %>
         </ol>
       </div>
     </div>
   </div>

   <div class="col-12 col-lg-5 col-xl-6 mt-4 mt-lg-0">
     <div class="row fw-bold text-center text-uppercase">
       <%= link_to icon_tag('prosecutors', size: 60) + content_tag(:span, t('.squares.prosecutors')), prosecutors_path, class: 'square mx-3 mb-4' %>
       <%= link_to icon_tag('general-office', size: 60) + content_tag(:span, t('.squares.offices')), offices_path, class: 'square mx-3 mb-4' %>
       <div class="d-block w-100"></div>
       <%= link_to icon_tag('criminality', size: 60) + content_tag(:span, t('.squares.criminality')), statistics_path, class: 'square mx-3 mb-4' %>
       <%= link_to icon_tag('magnifier', size: 60) + content_tag(:span, t('.squares.search')), 'https://transparency.blog.sme.sk/', class: 'square mx-3 mb-4' %>
     </div>
  </div>
</div>

<div class="row mt-5">
  <div class="col-12">
    <h2 class="mb-4 text-uppercase"><%= t '.average_incoming_cases_chart_title' %></h2>
    <%= tag.div class: 'chart chart-md', data: { controller: 'home-chart', home_chart_name_value: 'average-incoming-cases', home_chart_watermark_value: image_url("brands/transparency-international-slovensko.#{I18n.locale}.svg") } do %>
      <canvas data-home-chart-target="canvas" role="img" aria-label="<%= t '.average_incoming_cases_chart_title' %>"></canvas>
    <% end %>
  </div>
</div>

<div class="row mt-5">
  <div class="col-12">
    <h2 class="mb-4 text-uppercase"><%= t '.average_incoming_cases_comparison_chart_title' %></h2>
    <%= tag.div class: 'chart chart-sm', data: { controller: 'home-chart', home_chart_name_value: 'average-incoming-cases-comparison', home_chart_watermark_value: image_url("brands/transparency-international-slovensko.#{I18n.locale}.svg") } do %>
      <canvas data-home-chart-target="canvas" role="img" aria-label="<%= t '.average_incoming_cases_comparison_chart_title' %>"></canvas>
