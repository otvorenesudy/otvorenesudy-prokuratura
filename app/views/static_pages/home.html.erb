<div class="row mt-5">
  <div class="col-12">
    <h2 class="mb-4 text-uppercase"><%= t '.ratio_of_rest_to_incoming_cases_chart_title' %></h2>
    <%= tag.div class: 'chart chart-md', data: { controller: 'home-chart', home_chart_name_value: 'ratio-of-rest-to-incoming-cases', home_chart_watermark_value: image_url("brands/transparency-international-slovensko.#{I18n.locale}.svg") } do %>
      <canvas data-home-chart-target="canvas" role="img" aria-label="<%= t '.ratio_of_rest_to_incoming_cases_chart_title' %>"></canvas>
    <% end %>
  </div>
</div>

<div class="row mt-5">
  <div class="col-12">
    <h2 class="mb-4 text-uppercase"><%= t '.filed_cases_to_incoming_cases_chart_title' %></h2>
    <%= tag.div class: 'chart chart-md', data: { controller: 'home-chart', home_chart_name_value: 'filed-cases-to-incoming-cases', home_chart_watermark_value: image_url("brands/transparency-international-slovensko.#{I18n.locale}.svg") } do %>
      <canvas data-home-chart-target="canvas" role="img" aria-label="<%= t '.filed_cases_to_incoming_cases_chart_title' %>"></canvas>
