<ul class="facet-list">
  <% visible.each do |value| %>
    <%= capture(value, &renderer) %>
  <% end %>
</ul>

<% if hidden.present? %>
  <% open = selected.present? && (hidden.is_a?(Hash) ? hidden.keys : hidden).any? { |value| value.to_s.in?(selected) } %>

  <ul id="<%= id %>" class="facet-list collapse<%= ' show' if open %>">
    <% hidden.each do |value| %>
      <%= capture(value, &renderer) %>
    <% end %>
  </ul>

  <a href="#<%= id %>" class="facet-results-continuation<%= ' collapsed' unless open %>" data-bs-toggle="collapse" role="button" aria-controls="<%= id %>" aria-expanded="<%= open %>">
    <span class="show"><%= t '.show_more' %></span>
    <span class="hide"><%= t '.show_less' %></span>
  </a>
<% end %>
