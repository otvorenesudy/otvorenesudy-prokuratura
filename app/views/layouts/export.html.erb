<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= resolve_title(yield :title) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="prefetch" href="<%= asset_path 'icons.svg' %>">
    <link rel="prefetch" href="<%= asset_path 'brands.svg' %>">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Ubuntu:300,700&subset=latin-ext">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="container mt-4 px-sm-0">
      <%= yield %>
    </div>
  </body>
</html>
