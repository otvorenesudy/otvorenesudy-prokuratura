# Development settings, which dotenv-rails loads from .env. bin/setup copies this file to .env when there is none;
# edit .env for this machine and never commit it. Everything here is optional: without it, the app logs in to
# PostgreSQL on localhost with the login in Rails credentials, or else as your own user. Production doesn't load dotenv
# files: the server's environment sets the same variables.

# PostgreSQL
OPENCOURTS_PROKURATURA_DATABASE_HOST=localhost
# OPENCOURTS_PROKURATURA_DATABASE_USER=postgres
# OPENCOURTS_PROKURATURA_DATABASE_PASSWORD=

# Run Sidekiq jobs in the process that enqueues them, without bundle exec sidekiq.
# SIDEKIQ_INLINE=true
